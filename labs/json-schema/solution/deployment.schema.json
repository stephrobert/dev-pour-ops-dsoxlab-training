{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/deployment.schema.json",
  "type": "object",
  "required": ["service", "version", "environment", "replicas", "strategy"],
  "additionalProperties": false,
  "properties": {
    "service": {"type": "string", "minLength": 1},
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "environment": {
      "type": "string",
      "enum": ["development", "staging", "production"]
    },
    "replicas": {"type": "integer", "minimum": 1, "maximum": 20},
    "strategy": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["rolling", "canary"]},
        "max_unavailable": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    }
  }
}
