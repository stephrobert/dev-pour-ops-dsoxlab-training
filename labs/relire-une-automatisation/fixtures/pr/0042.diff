diff --git a/src/certcheck/maintenance.py b/src/certcheck/maintenance.py
new file mode 100644
index 0000000..f2bb49f
--- /dev/null
+++ b/src/certcheck/maintenance.py
@@ -0,0 +1,37 @@
+"""Maintenance de certcheck : purge des anciens rapports, notification de l'équipe."""
+
+from __future__ import annotations
+
+import json
+import os
+import shutil
+import time
+import urllib.request
+
+UNE_JOURNEE = 86400
+
+
+def purger_rapports(jours: int) -> int:
+    """Supprime les rapports de plus de `jours` jours ; rend le nombre supprimé."""
+    dossier = os.environ.get("CERTCHECK_REPORT_DIR", "") + "/"
+    limite = time.time() - jours * UNE_JOURNEE
+    supprimes = 0
+    for nom in os.listdir(dossier):
+        chemin = os.path.join(dossier, nom)
+        if os.path.getmtime(chemin) < limite:
+            shutil.rmtree(chemin, ignore_errors=True)
+            supprimes += 1
+    return supprimes
+
+
+def notifier(url: str, resultats: list[dict]) -> None:
+    """Poste la liste des certificats à renouveler sur le webhook du chat."""
+    alertes = [r["host"] for r in resultats if r["status"] in ("warning", "expired")]
+    if not alertes:
+        return
+    corps = json.dumps({"text": "À renouveler : " + ", ".join(alertes)}).encode()
+    demande = urllib.request.Request(url, data=corps, headers={"Content-Type": "application/json"})
+    try:
+        urllib.request.urlopen(demande, timeout=10)
+    except Exception:
+        pass
diff --git a/tests/test_maintenance.py b/tests/test_maintenance.py
new file mode 100644
index 0000000..3c6e12d
--- /dev/null
+++ b/tests/test_maintenance.py
@@ -0,0 +1,21 @@
+"""Tests de la purge des rapports."""
+
+import os
+from pathlib import Path
+
+import pytest
+
+from certcheck import maintenance
+
+
+def test_la_purge_retire_les_vieux_rapports(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    vieux = tmp_path / "2026-01-04"
+    vieux.mkdir()
+    os.utime(vieux, (0, 0))
+    recent = tmp_path / "2026-10-12"
+    recent.mkdir()
+    monkeypatch.setenv("CERTCHECK_REPORT_DIR", str(tmp_path))
+
+    assert maintenance.purger_rapports(30) == 1
+    assert recent.exists()
+    assert not vieux.exists()
