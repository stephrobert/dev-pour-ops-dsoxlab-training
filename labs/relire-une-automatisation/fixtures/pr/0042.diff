+++ b/tests/test_maintenance.py
@@ -0,0 +1,29 @@
+"""Tests de la purge des rapports."""
+
+import os
+from pathlib import Path
+
+import pytest
+
+import maintenance
+
+
+def test_la_purge_retire_les_vieux_rapports(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
+    vieux = tmp_path / "2026-01-04"
+    vieux.mkdir()
+    os.utime(vieux, (0, 0))
+    recent = tmp_path / "2026-10-12"
+    recent.mkdir()
+    monkeypatch.setenv("CERTCHECK_REPORT_DIR", str(tmp_path))
+
+    assert maintenance.purger_rapports(30) == 1
+    assert recent.exists()
+    assert not vieux.exists()
+
+
+def test_le_resume_ne_cite_que_les_alertes() -> None:
+    resultats = [
+        {"host": "web-01", "status": "ok", "days_left": 400, "not_after": "2027-11-17"},
+        {"host": "web-02", "status": "expired", "days_left": -3, "not_after": "2026-10-10"},
+    ]
+    assert maintenance.resume(resultats) == "web-02 : expired, -3 jours (2026-10-10)"
