diff --git a/maintenance.py b/maintenance.py
new file mode 100644
index 0000000..586483d
--- /dev/null
+++ b/maintenance.py
@@ -0,0 +1,54 @@
+"""Maintenance de certcheck : purge des anciens rapports, notification de l'équipe.
+
+Les rapports nocturnes s'accumulent dans CERTCHECK_REPORT_DIR, un
+sous-dossier par nuit. La purge retire ceux qui ont dépassé l'âge donné, et
+la notification poste le résumé des alertes sur le webhook du chat d'équipe.
+"""
+from __future__ import annotations
+
+import logging
+import os
+import shutil
+import time
+
+import requests
+import urllib3
+
+log = logging.getLogger("certcheck")
+
+UNE_JOURNEE = 86400
+
+
+def purger_rapports(jours: int) -> int:
+    """Supprime les rapports de plus de `jours` jours ; rend le nombre de rapports supprimés."""
+    dossier = os.environ.get("CERTCHECK_REPORT_DIR", "") + "/"
+    limite = time.time() - jours * UNE_JOURNEE
+    supprimes = 0
+    for nom in sorted(os.listdir(dossier)):
+        chemin = os.path.join(dossier, nom)
+        if os.path.getmtime(chemin) < limite:
+            shutil.rmtree(chemin, ignore_errors=True)
+            supprimes += 1
+    log.info("%d rapport(s) purgé(s) dans %s", supprimes, dossier)
+    return supprimes
+
+
+def resume(resultats: list[dict]) -> str:
+    """Le texte du message : une ligne par certificat à renouveler."""
+    return "\n".join(
+        f"{r['host']} : {r['status']}, {r['days_left']} jours ({r['not_after']})"
+        for r in resultats
+        if r["status"] in ("warning", "expired")
+    )
+
+
+def notifier(url: str, resultats: list[dict]) -> None:
+    """Poste le résumé des certificats à renouveler sur le webhook de l'équipe."""
+    texte = resume(resultats)
+    if not texte:
+        return
+    urllib3.disable_warnings()
+    try:
+        requests.post(url, json={"text": texte}, timeout=10, verify=False)
+    except Exception:
+        pass
